{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && .venv/bin/uvicorn app.main:app --reload --port ${BACKEND_PORT:-8000}"
      ],
      "port": 8000
    },
    {
      "name": "backend-8010",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && .venv/bin/uvicorn app.main:app --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "frontend-8010",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "API_PROXY_TARGET=http://localhost:8010 npm --prefix frontend run dev -- --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
