# 복사해서 backend/.env 로 사용: cp .env.example .env

# DB — SQLite로 시작. PostgreSQL 전환 시 URL만 교체
# 예: postgresql+psycopg://user:pass@localhost:5432/thinkguard
DATABASE_URL=sqlite:///./thinkguard.db

# 프론트 개발 서버 주소 (CORS 허용)
CORS_ORIGINS=["http://localhost:5173"]

# LLM Provider: mock | ollama
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 분류기: stub | module | http
CLASSIFIER=stub
# CLASSIFIER=module 일 때 "모듈경로:함수명"
CLASSIFIER_MODULE=thinkguard_nlp.classifier:classify
# CLASSIFIER=http 일 때 NLP 팀 FastAPI 엔드포인트
CLASSIFIER_URL=http://localhost:8001/classify
# 이 값보다 confidence가 낮으면 "모호함"으로 보고 되묻기
CLASSIFIER_MIN_CONFIDENCE=0.5

# 코드 실행: mock | docker
# docker 사용 전 이미지 빌드: docker build -t thinkguard-runner backend/sandbox
CODE_RUNNER=mock
RUNNER_IMAGE=thinkguard-runner
RUNNER_TIMEOUT_SEC=5
RUNNER_MEMORY_MB=128
